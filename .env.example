# Production – www.clever-neuwagen.de (IONOS VPS)
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
PUBLIC_URL=https://www.clever-neuwagen.de

# Berater-Pilot: Share-Links, Leads, Kundenakten (JSON, serverseitig)
# VPS: persistent außerhalb des Deploy-Verzeichnisses (siehe DEPLOY.md)
PILOT_DATA_DIR=/var/lib/clever-neuwagen/data

# Google Maps – Frontend (Autocomplete / Karten, nur VITE_-Variablen)
VITE_MAPS_PROVIDER=google
VITE_GOOGLE_MAPS_API_KEY=

# Google Places – echte Bewertungen (Server-only, nie im Frontend)
GOOGLE_PLACES_API_KEY=

# E-Mail (zentraler Versand über info@clever-neuwagen.de)
# mock | resend | smtp
MAIL_TRANSPORT=mock
RESEND_API_KEY=
# Optional Client-Hinweis (Anzeige)
VITE_MAIL_TRANSPORT=mock
VITE_EMAIL_PROVIDER=mock
VITE_RESEND_API_KEY=
VITE_EMAIL_FROM=info@clever-neuwagen.de

# Sprint 5 – Dokumenten-Tresor (optional, ≥32 Zeichen)
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_PURGE_INTERVAL_MS=900000

# Pilot LIVE – Autohaus Trinkle, nur Kia, echte Leads (Build-Zeit)
# Dev: npm run dev:pilot  oder  .env.local mit VITE_PILOT_LIVE=true
VITE_PILOT_LIVE=false
VITE_PILOT_DEALER_ID=autohaus-trinkle
VITE_PILOT_KIA_ONLY=true

# Interne Testumgebung (passwortgeschützt, nicht öffentlich)
# Dev: npm run dev:test  |  Build: npm run build:test
# Server optional zusätzlich: INTERNAL_TEST_ENV=true (robots.txt / sitemap)
VITE_INTERNAL_TEST_ENV=false

# OpenAI Berater – nur Server (nie VITE_, nie ins Frontend committen)
# Dev: in .env.local setzen, Server lädt beim Start via server/loadEnv.js
ADVISOR_USE_OPENAI=false
OPENAI_API_KEY=
# OPENAI_QUERY_MODEL=gpt-4o-mini

# Clever AI Conversation Engine (Responses API, server-only)
CLEVER_AI_CONVERSATION_ENABLED=false
# OPENAI_CLEVER_MODEL=gpt-5.6-luna
# CLEVER_AI_TIMEOUT_MS=25000
# Optional: Modellliste für clever:eval:compare (kommagetrennt)
# CLEVER_EVAL_MODELS=gpt-5.6-luna,gpt-4o-mini,gpt-5.6-terra

# Clever Shared Intelligence – Lexikon + Verkäufer-Copilot (Standard: aus)
CLEVER_LEXICON_AI_ENABLED=false
CLEVER_SELLER_COPILOT_ENABLED=false
# Magic Kunden-Nachricht (OpenAI Writer + verifizierte Fahrzeugdaten)
# Server: CLEVER_MAGIC_MESSAGE_ENABLED=true (+ OPENAI_API_KEY)
# Frontend: VITE_CLEVER_MAGIC_MESSAGE_ENABLED=true (oder VITE_CLEVER_SELLER_COPILOT_ENABLED=true)
# Ohne Flags/Key: geprüfter Offline-Fallback – Feedback kennzeichnet das klar (kein stilles Template als „Clever hat vorbereitet“)
CLEVER_MAGIC_MESSAGE_ENABLED=false
# Clever Universal Seller Orchestrator (Default: an; false = nur Interpretation, kein Action-Plan)
# CLEVER_SELLER_ORCHESTRATOR_ENABLED=false
# Seller OpenAI-Interpret (Default: aus; braucht OPENAI_API_KEY)
# Server: schwache Eskalation + Multi-Source Complexity (Mazzei-Dumps / GW+Vertrag)
# UI: VITE_…=true → komplexe Turns über POST /api/v1/clever/seller-turn (kein Browser-Key)
# Seller OpenAI Semantic Interpret für komplexe Multi-Source-Turns (Default: aus)
# Complexity Router entscheidet – kein manueller Modus
CLEVER_SELLER_OPENAI_INTERPRET_ENABLED=false
# Frontend: komplexe Turns → POST /api/v1/clever/seller-turn (kein Browser-API-Key)
# VITE_CLEVER_SELLER_OPENAI_INTERPRET_ENABLED=false

# Screenshot / WhatsApp-Bilder im Composer inhaltlich lesen (Vision + OCR-Fallback)
# Default (Flag unset): an, wenn OpenAI-Interpret ODER Contract-OCR aktiv
# Explizit aus: nur Soft-Attach („Foto angehängt“)
# Server: CLEVER_SCREENSHOT_INTERPRET_ENABLED → POST /api/v1/clever/screenshot-interpret
# Frontend: VITE_… steuert UI-Routing (Vision über Server, kein Browser-API-Key)
# CLEVER_SCREENSHOT_INTERPRET_ENABLED=true
# VITE_CLEVER_SCREENSHOT_INTERPRET_ENABLED=true

# CLEVER_OFFICIAL_WEB_SEARCH_ENABLED=false
# CLEVER_AI_ESCALATION_ENABLED=false
# OPENAI_CLEVER_ESCALATION_MODEL=gpt-5.6-terra
# VITE_CLEVER_AI_CONVERSATION_ENABLED=false
# VITE_CLEVER_LEXICON_AI_ENABLED=false
# VITE_CLEVER_SELLER_COPILOT_ENABLED=false
# VITE_CLEVER_MAGIC_MESSAGE_ENABLED=false

# Clever Seller Agent (OpenAI Responses → Tool Layer → Business-Logik)
# Server: CLEVER_AGENT_ENABLED=true + OPENAI_API_KEY
# Frontend Composer: VITE_CLEVER_AGENT_ENABLED=true (gleicher Endpoint für Text + Chips)
# CLEVER_AGENT_ENABLED=false
# VITE_CLEVER_AGENT_ENABLED=false
# OPENAI_CLEVER_AGENT_MODEL=gpt-4.1
# CLEVER_AGENT_DEBUG=false
# CLEVER_AGENT_MAX_TOOL_ROUNDS=8

# Contract Scan-OCR (Slice 19) – Default: aus → Manual-Fallback bei Scans
# Frontend (Vite): VITE_CLEVER_CONTRACT_OCR=true
# Server-Pendant (optional, gleiche Semantik): CLEVER_CONTRACT_OCR=true
# Engine: tesseract (Default, tesseract.js) | cloud (nur mit window.__cleverOcrProvider)
# VITE_CLEVER_CONTRACT_OCR=false
# CLEVER_CONTRACT_OCR=false
# VITE_CLEVER_CONTRACT_OCR_ENGINE=tesseract
# VITE_CLEVER_CONTRACT_OCR_LANG=deu
# Cloud: keinen API-Key hier – Provider zur Laufzeit injizieren:
#   window.__cleverOcrProvider = async ({ file }) => ({ text, confidence })

# Kalender Availability / Draft (Slice Calendar) – Default: aus → availabilityStatus: not_checked
# Frontend (Vite): VITE_CLEVER_CALENDAR=true
# Server-Pendant (optional): CLEVER_CALENDAR=true
# Ohne Flag: Verhalten wie Slice 5 (not_checked). Mit Flag: Local-Stub.
# Echte Outlook/Google-API: keinen OAuth-Key hier – Provider zur Laufzeit injizieren:
#   window.__cleverCalendarProvider = {
#     checkAvailability: async ({ startsAt, durationMinutes }) => ({ status: 'available'|'busy'|'unknown'|'error' }),
#     createDraftEvent: async ({ startsAt, title }) => ({ ok: true, booked: false, draft: { id, status: 'draft' } }),
#   }
# Oder als Function mit action: 'checkAvailability' | 'createDraftEvent'
# VITE_CLEVER_CALENDAR=false
# CLEVER_CALENDAR=false
